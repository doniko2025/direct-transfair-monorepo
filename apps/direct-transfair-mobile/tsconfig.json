{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "jsx": "react-jsx",
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "allowJs": false,
    "isolatedModules": true,
    "noEmit": true,
    "module": "ESNext",
    "verbatimModuleSyntax": false,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "types": [
      "react",
      "react-native",
      "node"
    ],
    "baseUrl": "."
  },
  "include": [
    "app",
    "assets",
    "services",
    "providers",
    "components",
    "theme",
    "utils",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ],
  "exclude": [
    "node_modules",
    "_old_routes",
    "__old_routes",
    "**/_old_routes/**",
    "**/__old_routes/**",
    "babel.config.js",
    "metro.config.js",
    "jest.config.js"
  ]
}
