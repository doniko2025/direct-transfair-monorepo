{
  "version": 2,
  "buildCommand": "npx expo export --platform web",
  "outputDirectory": "dist",
  "installCommand": "npm install --legacy-peer-deps",
  "framework": null,
  "rewrites": [
    { "source": "/:tenant", "destination": "/[tenant]" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}