# =========================================================================================================
# Direct Transf'air — application mobile (Expo) : variables d'environnement
#
# Copier ce fichier en « .env » (jamais committé) pour le développement local (npx expo start).
# Pour les builds EAS, ces mêmes variables se déclarent dans eas.json (profil « env ») ou dans les « Environment
# variables » du projet EAS. Elles sont INTÉGRÉES au build (préfixe EXPO_PUBLIC_) : changer une valeur = nouveau build.
# Une ligne commentée par « # » = valeur par défaut utilisée par le code (services/serverConfig.ts, platformConfig.ts…).
# =========================================================================================================

# ─── Serveur ───────────────────────────────────────────────────────────────────────────────────────────
# [RECOMMANDÉ] adresse du backend, sans « /api » final. En local sur téléphone : http://<IP-de-votre-PC>:3000
# Par défaut : https://direct-transfair-backend.onrender.com  (les anciens hôtes *.railway.app sont ignorés).
# EXPO_PUBLIC_API_URL=https://direct-transfair-backend.onrender.com
# [OPTIONNEL] préfixe des routes (/api)
# EXPO_PUBLIC_API_PREFIX=/api
# [OPTIONNEL] code de la société utilisée par défaut (en-tête x-tenant-id). Défaut : le code plateforme.
# EXPO_PUBLIC_TENANT_ID=DONIKO

# ─── Identité de la plateforme ─────────────────────────────────────────────────────────────────────────
# Le code doit être IDENTIQUE à PLATFORM_TENANT_CODE (backend) et VITE_PLATFORM_CODE (web-admin).
# EXPO_PUBLIC_PLATFORM_CODE=DONIKO
# EXPO_PUBLIC_PLATFORM_NAME=Direct Transf'air
# EXPO_PUBLIC_PLATFORM_TAGLINE=Transferts internationaux sécurisés
# EXPO_PUBLIC_PLATFORM_LOGO_URL=            # logo https ; sinon l'app lit celui de la société système sur le serveur
# EXPO_PUBLIC_BRAND_PRIMARY=#059669
# EXPO_PUBLIC_BRAND_SECONDARY=#10B981
# EXPO_PUBLIC_BRAND_SPLASH=#064E3B

# ─── Portails de sociétés ──────────────────────────────────────────────────────────────────────────────
# Domaine de base des portails (« sous-domaine.<domaine> »). Sans lui : pas de lien par sous-domaine,
# seuls les domaines propres des sociétés comptent.
# EXPO_PUBLIC_PORTAL_BASE_DOMAIN=
# Hôtes (séparés par des virgules) qui désignent la plateforme elle-même.
# EXPO_PUBLIC_PLATFORM_HOSTS=
# Adresse du portail web, utilisée par l'écran de parrainage quand la société n'a pas de portail propre.
# EXPO_PUBLIC_PORTAL_URL=

# ─── Contacts et mentions légales (valeurs de secours : les vraies viennent de la fiche société via l'API) ─
# EXPO_PUBLIC_SUPPORT_EMAIL=
# EXPO_PUBLIC_SUPPORT_PHONE=
# EXPO_PUBLIC_DPO_EMAIL=
# EXPO_PUBLIC_DATA_AUTHORITY_NAME=CNIL
# EXPO_PUBLIC_DATA_AUTHORITY_URL=https://www.cnil.fr
# EXPO_PUBLIC_LEGAL_JURISDICTION=           # défaut : « les tribunaux compétents »
# EXPO_PUBLIC_LEGAL_COMPANY_NAME=
# EXPO_PUBLIC_LEGAL_REGULATOR_NAME=
# EXPO_PUBLIC_LEGAL_REGULATOR_ACRONYM=
# EXPO_PUBLIC_LEGAL_FRAMEWORK=
# EXPO_PUBLIC_LEGAL_LICENSE_NUMBER=
# EXPO_PUBLIC_LEGAL_LICENSE_TYPE=
# EXPO_PUBLIC_LEGAL_CAPITAL=
# EXPO_PUBLIC_LEGAL_ADDRESS=
# EXPO_PUBLIC_LEGAL_MEDIATOR_NAME=
# EXPO_PUBLIC_LEGAL_MEDIATOR_URL=
# EXPO_PUBLIC_LEGAL_TERMS_VERSION=
# EXPO_PUBLIC_LEGAL_TERMS_DATE=

# ─── Règles et délais ──────────────────────────────────────────────────────────────────────────────────
# Âge minimal pour ouvrir un compte, de 13 à 99 (18).
# EXPO_PUBLIC_MIN_AGE=18
# Délai du renouvellement de session POST /auth/refresh, en ms, 3000 minimum (15000).
# EXPO_PUBLIC_REFRESH_TIMEOUT_MS=15000
# Durée maximale du chargement initial de l'app, en ms, de 2000 à 60000 (8000).
# EXPO_PUBLIC_AUTH_INIT_MAX_WAIT_MS=8000
# Délai avant l'abandon d'un chargement d'écran, en ms, de 3000 à 120000 (20000).
# EXPO_PUBLIC_LOAD_TIMEOUT_MS=20000
# Lien vers Sendwave (recharge par Sendwave).
# EXPO_PUBLIC_SENDWAVE_URL=https://www.sendwave.com
