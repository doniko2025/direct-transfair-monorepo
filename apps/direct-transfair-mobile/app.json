{
  "expo": {
    "name": "Direct Transf'air",
    "slug": "direct-transfair",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "directtransfair",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#06120C"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.doniko.directtransfair",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Direct Transf'air a besoin de la caméra pour scanner les QR codes de paiement."
      }
    },
    "android": {
      "softwareKeyboardLayoutMode": "pan",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0E3B2D"
      },
      "package": "com.doniko.directtransfair",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.READ_CONTACTS",
        "android.permission.WRITE_CONTACTS"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://directtransfair.app"
        }
      ],
      "expo-secure-store",
      "expo-font",
      "expo-image-picker",
      "expo-status-bar",
      "expo-sharing",
      [
        "expo-camera",
        {
          "cameraPermission": "Direct Transf'air a besoin de la caméra pour scanner les QR codes de paiement."
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Autoriser l'accès à vos contacts pour ajouter des bénéficiaires."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": "https://directtransfair.app"
      },
      "eas": {
        "projectId": "047c62b4-1687-4935-b8e1-c30aef4548f7"
      }
    }
  }
}
