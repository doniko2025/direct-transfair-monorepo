{
  "expo": {
    "name": "Direct Transf'air",
    "slug": "direct-transfair",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "directtransfair",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#06120C"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.doniko.directtransfair",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Direct Transf'air a besoin de la caméra pour scanner les QR codes de paiement et photographier votre pièce d'identité."
      }
    },
    "android": {
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundImage": "./assets/images/adaptive-background.png",
        "monochromeImage": "./assets/images/monochrome-icon.png",
        "backgroundColor": "#0F4430"
      },
      "package": "com.doniko.directtransfair",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_CONTACTS",
        "android.permission.RECORD_AUDIO",
        "android.permission.WRITE_CONTACTS"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.WRITE_CONTACTS"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://directtransfair.app"
        }
      ],
      "expo-secure-store",
      "expo-font",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Direct Transf'air a besoin de la caméra pour photographier votre pièce d'identité et votre selfie.",
          "photosPermission": "Direct Transf'air a besoin d'accéder à vos photos pour choisir une photo de votre pièce d'identité."
        }
      ],
      "expo-status-bar",
      "expo-sharing",
      [
        "expo-camera",
        {
          "cameraPermission": "Direct Transf'air a besoin de la caméra pour scanner les QR codes de paiement et photographier votre pièce d'identité.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Autoriser l'accès à vos contacts pour ajouter des bénéficiaires."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": "https://directtransfair.app"
      },
      "eas": {
        "projectId": "dd024b9e-ccb1-4b9b-9a4a-c9b8b9fd06c1"
      }
    },
    "owner": "dftransfer"
  }
}
