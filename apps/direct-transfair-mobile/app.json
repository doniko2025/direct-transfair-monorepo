{
  "expo": {
    "name": "Direct Transf'air",
    "slug": "direct-transfair",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "directtransfair",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#F7931E"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.doniko.directtransfair",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.doniko.directtransfair"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
  ["expo-router", { "origin": "https://directtransfair.app" }],
  "expo-secure-store",
  "expo-font",
  "expo-image-picker"
  ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": "https://directtransfair.app"
      },
      "eas": {
        "projectId": "dd024b9e-ccb1-4b9b-9a4a-c9b8b9fd06c1"
      }
    }
  }
}
