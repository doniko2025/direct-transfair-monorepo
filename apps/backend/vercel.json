{
  "version": 2,

  "buildCommand": "pnpm build",

  "installCommand": "pnpm install --no-frozen-lockfile",

  "outputDirectory": "dist",

  "builds": [
    {
      "src": "dist/main.js",
      "use": "@vercel/node"
    }
  ],

  "routes": [
    {
      "src": "/(.*)",
      "dest": "dist/main.js"
    }
  ]
}