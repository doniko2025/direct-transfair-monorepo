{
  "extends": "../../tsconfig.base.json",

  "compilerOptions": {
    /* =========================
     * BASE
     * ========================= */
    "baseUrl": "./",
    "paths": {},

    /* =========================
     * NESTJS (STABLE CJS)
     * ========================= */
    "module": "CommonJS",
    "moduleResolution": "node16",
    "target": "ES2021",
    "lib": ["ES2021"],

    /* =========================
     * STRUCTURE
     * ========================= */
    "rootDir": "./src",
    "outDir": "./dist",

    /* =========================
     * EMIT
     * ========================= */
    "sourceMap": true,
    "declaration": false,
    "removeComments": true,

    /* =========================
     * DECORATORS (NestJS)
     * ========================= */
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,

    /* =========================
     * INTEROP
     * ========================= */
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,

    /* =========================
     * PERF
     * ========================= */
    "incremental": true,
    "skipLibCheck": true,

    /* =========================
     * TYPES
     * ========================= */
    "strict": false,
    "strictNullChecks": true,
    "noImplicitAny": false,

    /* =========================
     * SECURITE
     * ========================= */
    "forceConsistentCasingInFileNames": true,

    "types": ["node", "express"],
    "typeRoots": ["./node_modules/@types", "./src/types"]
  },

  /* =========================
   * TS-NODE (PRISMA / SEED)
   * ========================= */
  "ts-node": {
    "compilerOptions": {
      "module": "CommonJS",
      "moduleResolution": "node16"
    }
  },

  /* =========================
   * INCLUDE / EXCLUDE
   * ========================= */
  "include": [
    "src/**/*.ts",
    "src/types/**/*.d.ts"
  ],

  "exclude": [
    "node_modules",
    "dist",
    "test",
    "**/*.spec.ts",
    "**/*.e2e-spec.ts",
    "prisma"
  ],

  /* ✅ FIX TS 5.6+ WARNINGS */
  "ignoreDeprecations": "6.0"
}