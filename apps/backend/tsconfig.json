{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    /* Neutralisation des paths monorepo */
    "baseUrl": "./",
    "paths": {},

    /* NestJS backend */
    "module": "commonjs",
    "moduleResolution": "node",
    "target": "ES2021",
    "lib": ["ES2021"],

    /* Structure */
    "rootDir": "./src",
    "outDir": "./dist",

    /* Émission */
    "sourceMap": true,
    "declaration": false,
    "removeComments": true,

    /* Décorateurs (NestJS) */
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,

    /* Interop */
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,

    /* Performance */
    "incremental": true,
    "skipLibCheck": true,

    /* Typage */
    "strict": false,
    "strictNullChecks": true,
    "noImplicitAny": false,

    /* Sécurité */
    "forceConsistentCasingInFileNames": true,

    "types": ["node", "express"],
    "typeRoots": ["./node_modules/@types", "./src/types"]
  },

  /* Force ts-node (Prisma) à utiliser les bons réglages */
  "ts-node": {
    "compilerOptions": {
      "module": "commonjs",
      "moduleResolution": "node"
    }
  },

  "include": [
    "src/**/*.ts",
    "src/types/**/*.d.ts"
  ],

  "exclude": [
    "node_modules",
    "dist",
    "test",
    "**/*.spec.ts",
    "**/*.e2e-spec.ts",
    "prisma"
  ],

  /* ✅ PLACEMENT CHIRURGICAL : À la racine pour faire taire VS Code sans faire planter Prisma */
  "ignoreDeprecations": "5.0"
}