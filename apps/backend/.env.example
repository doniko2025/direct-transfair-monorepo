# =========================================================================================================
# Direct Transf'air — backend NestJS : variables d'environnement
# Copier ce fichier en « .env » (jamais committé) et renseigner les valeurs.
#
# Légende :  [OBLIGATOIRE] le démarrage échoue ou une fonction vitale manque sans elle
#            [RECOMMANDÉ]  fonctionne sans, mais à définir en production
#            [OPTIONNEL]   la valeur par défaut convient (indiquée entre parenthèses)
# Une ligne commentée par « # » = valeur par défaut utilisée par le code.
# =========================================================================================================


# ─── Base de données ───────────────────────────────────────────────────────────────────────────────────
# [OBLIGATOIRE] PostgreSQL de l'application (connexion poolée si vous utilisez Neon / pgbouncer).
DATABASE_URL=postgresql://utilisateur:motdepasse@localhost:5432/direct_transfair?schema=public
# [OBLIGATOIRE pour les migrations] connexion directe (sans pooler) utilisée par « prisma migrate ».
DIRECT_URL=postgresql://utilisateur:motdepasse@localhost:5432/direct_transfair?schema=public
# [OBLIGATOIRE] base « plateforme » (console Grand Chef : sociétés, domaines). Voir prisma-platform/.
DATABASE_URL_PLATFORM=postgresql://utilisateur:motdepasse@localhost:5432/direct_transfair_platform?schema=public


# ─── Serveur ───────────────────────────────────────────────────────────────────────────────────────────
# [OPTIONNEL] (3000)
# PORT=3000
# [RECOMMANDÉ] « production » en ligne : active HSTS, cookies Secure, Swagger fermé, JWT_SECRET exigé.
NODE_ENV=development
# [OPTIONNEL] nombre de proxys devant l'API pour lire la vraie adresse IP (1 en production, 0 sinon).
# Railway / Render / Vercel : 1. Mettre 0 si l'API est exposée directement.
# TRUST_PROXY_HOPS=1
# [OPTIONNEL] Swagger (/api/docs) : « true » / « false » (ouvert hors production, fermé en production).
# SWAGGER_ENABLED=false
# [RECOMMANDÉ] fuseau des tâches planifiées (snapshot de trésorerie à minuit, balayage des codes expirés à 03:15).
# Sans lui, c'est l'heure du serveur (souvent UTC).
# TZ=Africa/Conakry


# ─── Sécurité & sessions ───────────────────────────────────────────────────────────────────────────────
# [OBLIGATOIRE en production] secret de signature des jetons, 32 caractères minimum.
# Sans lui en production l'API refuse de démarrer ; en développement un secret aléatoire change à chaque redémarrage.
# Générer : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# [OPTIONNEL] durée de vie du jeton d'accès (1h). Une session révoquée est refusée tout de suite, quelle que soit cette durée.
# ACCESS_TOKEN_TTL=1h
# [OPTIONNEL] anciens noms toujours lus : JWT_EXPIRES_IN, JWT_EXPIRES (à remplacer par ACCESS_TOKEN_TTL).
# [OPTIONNEL] exige un code OTP à chaque connexion par mot de passe (false).
# LOGIN_OTP_REQUIRED=false

# TESTS UNIQUEMENT (lot 13) : accepte le code secret 000000 pour tous les comptes clients / marchands du portefeuille.
# Désactivé par défaut. À retirer (ou laisser commenté) avant la mise en production.
# TEST_PIN_ENABLED=true
# [OPTIONNEL] essais autorisés pour saisir un code OTP avant invalidation, de 3 à 20 (5).
# OTP_MAX_ATTEMPTS=5

# Cookie httpOnly du refresh token (portail web uniquement ; le mobile garde ses jetons dans le corps de la réponse).
# [OPTIONNEL] nom du cookie (dt_rt)
# AUTH_COOKIE_NAME=dt_rt
# [RECOMMANDÉ] lax | strict | none. Défaut : « none » en production, « lax » sinon.
#   Site web et API sur le MÊME domaine (proxy /api) → lax.   Domaines différents → none (cookie Secure obligatoire,
#   et certains navigateurs bloquent les cookies tiers : préférer le proxy).
# AUTH_COOKIE_SAMESITE=lax
# [OPTIONNEL] « false » pour tester en http local (ignoré si SameSite=none). Défaut : true en production.
# AUTH_COOKIE_SECURE=true
# [OPTIONNEL] domaine du cookie, ex. « .exemple.com » pour le partager entre sous-domaines.
# AUTH_COOKIE_DOMAIN=


# ─── CORS (origines autorisées à appeler l'API depuis un navigateur) ───────────────────────────────────────
# [RECOMMANDÉ] origines exactes séparées par des virgules, ex. https://admin.exemple.com
CORS_ORIGINS=
# [RECOMMANDÉ] adresse du portail web (ajoutée aux origines CORS ; sert aussi de lien dans les courriels).
FRONTEND_URL=
# [RECOMMANDÉ en production] suffixes de domaine acceptés. Défaut historique « .vercel.app,.railway.app » = tout site
# hébergé là est accepté. Mettre la variable VIDE pour n'accepter que CORS_ORIGINS.
CORS_ALLOWED_SUFFIXES=
# [OPTIONNEL] autorise http://localhost en CORS (true). Mettre false en production.
# CORS_ALLOW_LOCALHOST=false


# ─── Plateforme (marque et domaines) ───────────────────────────────────────────────────────────────────
# [RECOMMANDÉ] domaines de la console plateforme, séparés par des virgules (ex. console.exemple.com).
PLATFORM_CONSOLE_HOSTS=
# [OPTIONNEL] domaine de base des portails de sociétés (ex. exemple.app → acme.exemple.app).
PORTAL_BASE_DOMAIN=
# Marque : ces valeurs apparaissent dans les courriels, SMS, contrats et Swagger.
# PLATFORM_NAME=Direct Transf'air
# PLATFORM_LEGAL_NAME=            # raison sociale en pied de courriel (défaut : PLATFORM_NAME)
# PLATFORM_TENANT_CODE=DONIKO     # code de la société système
# PLATFORM_LEGACY_CODES=10        # alias historiques du code plateforme
# PLATFORM_APP_URL=               # adresse publique du portail (défaut : FRONTEND_URL) — liens de signature de contrat
# PLATFORM_WEBSITE_URL=
# PLATFORM_SUPPORT_EMAIL=         # (ou SUPPORT_EMAIL)
# PLATFORM_LOGO_URL=
# PLATFORM_LOGO_ANIMATED_URL=
# PLATFORM_BRAND_COLOR=#0E3B2D
# PLATFORM_ACCENT_COLOR=#F5C32C
# PLATFORM_ANDROID_URL=
# PLATFORM_IOS_URL=

# Connexion unique depuis la console plateforme (facultatif). Absent ou < 32 caractères = route fermée.
# PLATFORM_SSO_SECRET=
# PLATFORM_SSO_ALLOWED_EMAILS=    # comptes autorisés, séparés par des virgules
# PLATFORM_SSO_ISSUER=
# PLATFORM_SSO_AUDIENCE=


# ─── Courriel ──────────────────────────────────────────────────────────────────────────────────────────
# Envoi tenté d'abord par l'API HTTP (Resend), puis par SMTP. Au moins un des deux est nécessaire :
# sans courriel, aucun code OTP par e-mail ni contrat n'est envoyé.
# [RECOMMANDÉ] API HTTP (fonctionne même si le SMTP sortant est bloqué par l'hébergeur)
MAIL_FALLBACK_PASS=
MAIL_FALLBACK_FROM=            # (ou MAIL_FALLBACK_USER)
# [OPTIONNEL] SMTP
MAIL_HOST=
# MAIL_PORT=587
# MAIL_SECURE=false
MAIL_USER=
# MAIL_PASS=                      # (ou MAIL_PASSWORD)
# MAIL_FROM=                      # défaut : MAIL_USER
# MAIL_SERVICE=gmail              # raccourci pour un compte Gmail (mot de passe d'application)


# ─── SMS (codes OTP, notifications de transfert) ───────────────────────────────────────────────────────
# [RECOMMANDÉ] Twilio. Sans ces trois variables : mode « stub » — AUCUN SMS n'est envoyé (le texte n'est
# pas écrit dans les logs en production). Les connexions par téléphone ne fonctionnent donc pas.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=


# ─── Notifications push (Firebase Cloud Messaging) ─────────────────────────────────────────────────────
# [OPTIONNEL] sans ces trois variables, les notifications push sont désactivées.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Garder les « \n » littéraux entre guillemets :
FIREBASE_PRIVATE_KEY=


# ─── Contrats (identité de l'émetteur) ─────────────────────────────────────────────────────────────────
# Tous optionnels ; les valeurs par défaut sont indiquées.
# CONTRACT_ISSUER_NAME=           # défaut : PLATFORM_LEGAL_NAME
# CONTRACT_ISSUER_LEGAL_FORM=
# CONTRACT_ISSUER_REGISTRATION=
# CONTRACT_ISSUER_ADDRESS=
# CONTRACT_ISSUER_REPRESENTATIVE=Thierno Doniko
# CONTRACT_ISSUER_TITLE=Grand Chef
# CONTRACT_ISSUER_EMAIL=          # défaut : PLATFORM_SUPPORT_EMAIL
# CONTRACT_COPY_EMAIL=            # copie de chaque contrat signé (défaut : CONTRACT_ISSUER_EMAIL)
# CONTRACT_JURISDICTION_CITY=Paris
# CONTRACT_SIGN_LINK_DAYS=30


# ─── Domaines personnalisés des portails de sociétés ───────────────────────────────────────────────────
# Facultatif : sans Vercel/Cloudflare configurés, l'ajout automatique de domaines est désactivé.
# VERCEL_API_TOKEN=
# VERCEL_TEAM_ID=
# PORTAL_VERCEL_PROJECT_ID=
# CLOUDFLARE_API_TOKEN=           # ou bien CLOUDFLARE_EMAIL + CLOUDFLARE_GLOBAL_KEY
# CLOUDFLARE_EMAIL=
# CLOUDFLARE_GLOBAL_KEY=
# CLOUDFLARE_ACCOUNT_ID=
# PORTAL_DNS_A_TARGET=76.76.21.21
# PORTAL_DNS_CNAME_TARGET=cname.vercel-dns.com
# PORTAL_RESERVED_SUBDOMAINS=     # sous-domaines interdits aux sociétés (liste par défaut dans le code)
# PORTAL_MULTIPART_SUFFIXES=      # suffixes à plusieurs niveaux, ex. co.uk (liste par défaut dans le code)
# PORTAL_DOMAINS_CRON=true        # « false » coupe la vérification automatique des domaines (toutes les 5 min)
# PORTAL_DOMAINS_MAX_ATTEMPTS=


# ─── Règles métier réglables ───────────────────────────────────────────────────────────────────────────
# Les frais, commissions, validité des codes de retrait, seuils d'alerte et moyens de recharge sont réglés PAR SOCIÉTÉ
# dans l'interface (Paramètres › Réglages de la société). Les variables ci-dessous ne sont que des valeurs de repli.
# [OPTIONNEL] validité d'un code de retrait en mois, de 1 à 36 (5).
# PICKUP_CODE_VALIDITY_MONTHS=5
# [OPTIONNEL] « false » coupe le balayage quotidien des codes expirés sur CETTE instance (ex. si un worker dédié le fait).
# PICKUP_EXPIRY_CRON=true
# [OPTIONNEL] seuil anti-blanchiment : montant (équivalent XOF) à partir duquel un envoi est examiné (2000000).
# AML_THRESHOLD_XOF=2000000
# [OPTIONNEL] score de risque, de 1 à 100, à partir duquel un envoi est marqué suspect (60).
# AML_FLAG_SCORE=60
# [OPTIONNEL] vérification d'identité (KYC) des clients wallet : « off » suspend le blocage des envois, virements programmés
# et les rappels aux clients non vérifiés (recette, déploiement progressif). Défaut : actif. À laisser actif en production.
# KYC_ENFORCEMENT=on


# ─── Paiements simulés (aucun prestataire de paiement réel n'est branché) ──────────────────────────────
# [RECOMMANDÉ AU LANCEMENT] « true » coupe les recharges carte / Orange Money / Sendwave pour TOUTES les sociétés
# (elles réussissent toujours, sans vrai prélèvement). Chaque société peut aussi fermer ces moyens dans ses réglages.
BLOCK_SIMULATED_RECHARGES=false
# [DÉVELOPPEMENT SEULEMENT] « true » rouvre POST /payments/initiate (l'expéditeur pourrait marquer son envoi payé).
# ALLOW_SIMULATED_PAYMENTS=false
# [À FERMER EN PRODUCTION] « false » interdit l'auto-alimentation du solde par un admin (true).
# ALLOW_SELF_FUNDING=false


# ─── Jeu de données initial (prisma db seed) ───────────────────────────────────────────────────────────
# Utilisées seulement par « prisma/seed.ts ».
# SEED_SUPER_ADMIN_EMAIL=
# SEED_SUPER_ADMIN_PASSWORD=      # 12 caractères minimum ; si vide, un mot de passe aléatoire est généré
# SEED_BRAND_PRIMARY=#059669
# SEED_BRAND_SECONDARY=#10B981
# SEED_FORCE=false                # « true » : relance le seed sur une base déjà peuplée
# SEED_ALLOW_PRODUCTION=false     # « true » : autorise le seed quand NODE_ENV=production
