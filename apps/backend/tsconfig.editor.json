{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    /* VS Code only fixes */
    "noEmit": true,

    /* Important pour éviter les faux conflits de modules */
    "module": "ESNext",
    "moduleResolution": "bundler",

    /* Meilleure compat VS Code */
    "resolveJsonModule": true,
    "isolatedModules": true,

    /* Stabilise les erreurs fantômes */
    "allowJs": true,
    "checkJs": false
  },
  "include": [
    "src",
    "prisma",
    "**/*.ts"
  ]
}