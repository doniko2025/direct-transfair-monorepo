// ==========================================================
//  PRISMA SCHEMA — DIRECT TRANSF'AIR (SAAS EDITION)
//  UPDATED: SECURITY & MFA & TENANT SUPPORT
// ==========================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===================== ENUMS =====================

enum Role {
  SUPER_ADMIN
  COMPANY_ADMIN
  AGENT
  USER
}

enum SubscriptionType {
  RENTAL
  PURCHASE
}

enum SubscriptionStatus {
  ACTIVE
  INACTIVE
  EXPIRED
  SUSPENDED
}

enum TransactionStatus {
  PENDING
  VALIDATED
  PAID
  CANCELLED
}

enum PayoutMethod {
  CASH_PICKUP
  BANK_DEPOSIT
  MOBILE_MONEY
  WALLET
}

enum PaymentMethod {
  WALLET
  ORANGE_MONEY
  SENDWAVE
  CARD
  CASH
  BANK_TRANSFER 
}

enum PaymentProvider {
  DIRECT
  ORANGE_MONEY
  SENDWAVE
}

enum ProviderStatus {
  PENDING
  SUCCESS
  FAILED
  CANCELLED
}

enum WithdrawalStatus {
  PENDING
  APPROVED
  PAID
  REJECTED
  FAILED
  CANCELLED
}

enum TransactionType {
  TRANSFER        
  DEPOSIT         
  WITHDRAWAL      
  SERVICE_PAYMENT 
}

enum AgencyType {
  SUBSIDIARY
  PARTNER
}

enum CommissionSourceType {
  SUBSIDIARY
  PARTNER
  WALLET
}

enum CommissionDestType {
  SUBSIDIARY
  PARTNER
}

// ===================== TENANT (PLATEFORME MULTI-SOCIÉTÉS) =====================
// ✅ AJOUT INDISPENSABLE POUR NEON & GESTION SAAS

model Tenant {
  id          Int      @id @default(autoincrement())
  code        String   @unique
  name        String
  databaseUrl String?  // Optionnel pour permettre la cohabitation
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("tenants")
}

// ===================== CLIENT (LA SOCIÉTÉ) =====================

model Client {
  id    Int    @id @default(autoincrement())
  code  String @unique
  name  String

  logoUrl        String?
  primaryColor   String? @default("#F7931E")

  address        String?
  phone          String?
  email          String?

  activitySector String?
  contactPhone   String?
  contactEmail   String?

  ownerFirstName   String?
  ownerLastName    String?
  ownerBirthDate   String?
  ownerBirthPlace  String?
  ownerCountry     String?
  ownerAddress     String?

  representativeName String?
  representativeDocs String?

  subscriptionType   SubscriptionType   @default(RENTAL)
  subscriptionStatus SubscriptionStatus @default(ACTIVE)
  subscriptionEnd    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users             User[]
  agencies          Agency[]
  beneficiaries     Beneficiary[]
  transactions      Transaction[]
  withdrawals       Withdrawal[]
   
  commissionConfigs CommissionConfig[]
}

// ===================== COMMISSION CONFIGURATION =====================

model CommissionConfig {
  id        String   @id @default(cuid())
   
  clientId  Int
  client    Client   @relation(fields: [clientId], references: [id])

  sourceType      CommissionSourceType
  destType        CommissionDestType

  senderShare     Float @default(0)
  payerShare      Float @default(0)
  platformShare   Float @default(100)

  updatedAt DateTime @updatedAt

  @@unique([clientId, sourceType, destType])
}

// ===================== AGENCY (L'AGENCE PHYSIQUE) =====================

model Agency {
  id      String @id @default(cuid())
  name    String
  city    String
  address String

  type    AgencyType @default(SUBSIDIARY)

  code  String? @unique
  email String?

  phone String?

  country  String?
  currency String @default("XOF")

  balance     Decimal @default(0) @db.Decimal(12, 2)
  creditLimit Decimal @default(0) @db.Decimal(12, 2)
  cash        Decimal @default(0) @db.Decimal(12, 2)

  isActive Boolean @default(true)

  clientId Int
  client   Client @relation(fields: [clientId], references: [id])

  agents User[] @relation("AgencyAgents")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ===================== USER (ACTEURS) =====================

model User {
  id        String @id @default(cuid())
  email     String @unique
  password  String
  role      Role   @default(USER)

  // ✅ MODIFIÉ : Le téléphone doit être unique pour servir d'identifiant
  phone     String? @unique 
   
  firstName String?
  lastName  String?
  gender    String?
  jobTitle  String?

  addressStreet String?
  postalCode    String?
  city          String?
  country       String?

  nationality  String?
  birthDate    String?
  birthPlace   String?
  birthCountry String?
  birthCity    String?

  balance Decimal @default(0) @db.Decimal(12, 2)

  // ✅ NOUVEAU : Champs de Sécurité (MFA & Vérification)
  isEmailVerified Boolean @default(false)
  isPhoneVerified Boolean @default(false)
   
  otpCode        String?   // Code OTP temporaire
  otpExpiresAt   DateTime? // Expiration du code
  otpType        String?   // 'EMAIL_VERIFY', 'PHONE_VERIFY', 'PASSWORD_RESET'

  // Relations existantes
  clientId Int?
  client   Client? @relation(fields: [clientId], references: [id])

  agencyId String?
  agency   Agency? @relation("AgencyAgents", fields: [agencyId], references: [id])

  sentTransactions      Transaction[] @relation("Sender")
  receivedTransactions  Transaction[] @relation("Recipient")

  beneficiaries Beneficiary[]

  processedWithdrawals Withdrawal[] @relation("ProcessedWithdrawals")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ===================== BENEFICIARY =====================

model Beneficiary {
  id        String @id @default(cuid())
  fullName  String
  country   String
  city      String
  phone     String?

  userId String
  user   User @relation(fields: [userId], references: [id])

  clientId Int
  client   Client @relation(fields: [clientId], references: [id])

  transactions Transaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ===================== TRANSACTION =====================

model Transaction {
  id        String @id @default(cuid())
  reference String @unique

  type TransactionType @default(TRANSFER)

  amount Decimal @db.Decimal(12, 2)
  fees   Decimal @db.Decimal(12, 2)
  total  Decimal @db.Decimal(12, 2)

  currency String 

  targetCurrency String?    
  exchangeRate   Float?     
  receivedAmount Decimal?  @db.Decimal(12, 2) 

  status       TransactionStatus @default(PENDING)
  payoutMethod PayoutMethod      @default(CASH_PICKUP)

  paymentMethod PaymentMethod @default(WALLET)

  provider         PaymentProvider?
  providerRef      String?
  providerStatus   ProviderStatus? @default(PENDING)

  senderId String
  sender   User @relation("Sender", fields: [senderId], references: [id])

  recipientId String?
  recipient   User? @relation("Recipient", fields: [recipientId], references: [id])

  beneficiaryId String?
  beneficiary   Beneficiary? @relation(fields: [beneficiaryId], references: [id])

  clientId Int
  client   Client @relation(fields: [clientId], references: [id])

  withdrawal Withdrawal?

  paidAt      DateTime?
  cancelledAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ===================== WITHDRAWAL =====================

model Withdrawal {
  id String @id @default(cuid())

  transactionId String      @unique
  transaction   Transaction @relation(fields: [transactionId], references: [id])

  method PayoutMethod
  status WithdrawalStatus @default(PENDING)

  requestedAt DateTime  @default(now())
  processedAt DateTime?

  processedById String?
  processedBy   User? @relation("ProcessedWithdrawals", fields: [processedById], references: [id])

  clientId Int
  client   Client @relation(fields: [clientId], references: [id])
}

// ===================== TAUX DE CHANGE =====================

model ExchangeRate {
  id        String @id @default(cuid())
  pair      String @unique
  rate      Float
  updatedAt DateTime @updatedAt
}
