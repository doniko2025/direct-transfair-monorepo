// ==========================================================
//  PRISMA SCHEMA — DIRECT TRANSF'AIR (SAAS EDITION v5.0 ULTIMATE)
//
//  FUSION COMPLÈTE v4.0 + v4.1 + v4.2 + v5.0
//
//  ✅ Multi-Tenant SaaS (Tenant → Client)
//  ✅ Multi-Currency typé (enum CurrencyCode)
//  ✅ Wallets multi-devises avec version optimistic locking + freeze
//  ✅ KYC / AML / Compliance (ComplianceStatus + ComplianceCase)
//  ✅ OTP + MFA + Device Trust + Login History
//  ✅ Push Notifications FCM/APNS / SMS / Email
//  ✅ Treasury / Ledger double-entrée / Audit Logs
//  ✅ Loyalty / Promotions / Referrals
//  ✅ Rate Alerts / Scheduled Transfers
//  ✅ UserCard (tokenisée PSP) + UserMobileWallet
//  ✅ API Keys + Webhooks
//  ✅ Support Tickets
//  ✅ Beneficiary complet (IBAN, Mobile Money)
//  ✅ Commission Config & Tiers multi-devises
//  ✅ ExchangeRate avec historique, spread, isActive
//  ✅ Transaction avec direction, riskScore, receiptUrl
//  ✅ Withdrawal complet
//  ✅ ScheduledTransfer (récurrence, failureCount)
//  ✅ Précision financière @db.Decimal(18, 4)
//  ✅ soft-delete (deletedAt) sur User, Client, Agency, Transaction
//  ✅ Notification enrichie (priority, groupKey, expiresAt)
//  ✅ CommunicationLog enrichi (metadata, externalId)
//  ✅ TreasurySnapshot enrichi (métriques avancées)
//  ✅ CommissionConfig enrichi (description, priority)
// ==========================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearch", "fullTextIndex"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")    // ← déjà là
  directUrl = env("DIRECT_URL")      // ← ajouter cette ligne
}

// =========================================================
// ENUMS
// =========================================================

// Devises supportées — typées pour éviter les erreurs de saisie
enum CurrencyCode {
  XOF
  EUR
  USD
  GNF
  GBP
}

enum Role {
  SUPER_ADMIN    // Plateforme SaaS — accès total
  COMPANY_ADMIN  // Admin de la société cliente
  AGENT          // Agent en agence
  USER           // Client final
}

enum ComplianceStatus {
  CLEAR    // Aucun problème
  REVIEW   // En cours de révision AML/KYC
  BLOCKED  // Compte bloqué par compliance
}

enum SubscriptionType {
  RENTAL
  PURCHASE
}

enum SubscriptionStatus {
  ACTIVE
  INACTIVE
  EXPIRED
  SUSPENDED
  TRIAL
}

enum TransactionStatus {
  PENDING
  VALIDATED
  PROCESSING
  PAID
  CANCELLED
  FAILED
  REFUNDED
  ON_HOLD  // Bloqué AML/compliance
  EXPIRED  // Code de retrait expiré
}

enum TransactionDirection {
  INBOUND   // Argent reçu
  OUTBOUND  // Argent envoyé
  INTERNAL  // Transfert interne (ex: wallet → wallet)
}

enum TransactionType {
  TRANSFER
  DEPOSIT
  WITHDRAWAL
  SERVICE_PAYMENT
  INTERNAL_TRANSFER
  FEE_COLLECTION
  EXCHANGE        // Conversion multi-devises
  AGENCY_REFILL
  // ✅ v5.1 — Ajoutés pour la trésorerie agence ⇄ société (voir
  // agency-treasury.service.ts, fichier indépendant, aucune logique
  // existante touchée). Même sens de mouvement (agence → société),
  // seul le côté qui initie diffère :
  AGENCY_REMITTANCE  // Agent → Société : remontée de fonds initiée par l'agent
  AGENCY_COLLECTION  // Société → Agence (sens du solde) : retrait forcé initié par l'admin
  REFUND
  LOYALTY_CREDIT  // Crédit points fidélité
  SCHEDULED       // Virement programmé
}

enum PayoutMethod {
  CASH_PICKUP
  BANK_DEPOSIT
  MOBILE_MONEY
  WALLET
  IBAN_TRANSFER
