// =========================================================
// CURRENCY MAP
// Utilitaire : pays → devise par défaut
// Ex : FR → EUR, GN → GNF, US → USD, GB → GBP, SN → XOF
// =========================================================

model CountryCurrency {
  id             Int          @id @default(autoincrement())
  countryCode    String       @unique  // ISO 3166-1 alpha-2 : "FR", "GN", "US", "GB"…
  countryName    String
  currencyCode   CurrencyCode          // Typé enum
  currencyName   String
  currencySymbol String
  flagEmoji      String?
  phonePrefix    String?               // Ex: "+33", "+224"
  region         String?               // Ex: "Europe", "Afrique de l'Ouest"
  isSupported    Boolean      @default(true)

  @@index([currencyCode])
  @@map("country_currencies")
}

// =========================================================
// TENANT
// Niveau racine du multi-tenant SaaS
// =========================================================

model Tenant {
  id          Int      @id @default(autoincrement())
  code        String   @unique
  name        String
  databaseUrl String?  // Pour isolation DB si besoin
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  clients Client[]

  @@map("tenants")
}

// =========================================================
// CLIENT (Société SaaS cliente) — schema.prisma v5.1
// ✅ v5.0 conservé intégralement
// ✅ v5.1 : subdomain + customDomain ajoutés
//   - subdomain    : "flash" → flash.direct-transfer.com
//   - customDomain : "www.flash-transfer.com" (CNAME DNS)
//   → Chaque société peut avoir son portail web dédié
//   → Détecté automatiquement par TenantProvider au démarrage
//   → Migration : npx prisma migrate dev --name add_subdomain_custom_domain
// =========================================================

model Client {
  id   Int    @id @default(autoincrement())
  code String @unique
  name String

  // ── Rattachement tenant ───────────────────────────────
  tenantId Int?
  tenant   Tenant? @relation(fields: [tenantId], references: [id])

  // ── Branding ──────────────────────────────────────────
  logoUrl        String?
  primaryColor   String?      @default("#059669")
  secondaryColor String?      @default("#10B981")
  tagline        String?      // Slogan affiché sur la page login
  fontFamily     String?      // Police principale ex: "Georgia"
  splashBgColor  String?      // Couleur fond login (hex)
  welcomeMessage String?      // Message d'accueil personnalisé
  timezone       String?      @default("Africa/Conakry")
  locale         String?      @default("fr-GN")
  defaultCurrency CurrencyCode @default(GNF)

  // ── Portail web dédié ✅ v5.1 ─────────────────────────
  subdomain    String? @unique  // Ex: "flash" → flash.direct-transfer.com
  customDomain String? @unique  // Ex: "www.flash-transfer.com" (domaine custom CNAME)

  // ── Coordonnées ───────────────────────────────────────
  address  String?
  phone    String?
  email    String?
  website  String?
  country  String?  // ISO alpha-2
  city     String?

  // ── Secteur / contact opérationnel ───────────────────
  activitySector String?
  contactPhone   String?
  contactEmail   String?

  // ── Propriétaire légal ────────────────────────────────
  ownerFirstName  String?
  ownerLastName   String?
  ownerBirthDate  String?
  ownerBirthPlace String?
  ownerCountry    String?
  ownerAddress    String?

  // ── Représentant légal ────────────────────────────────
  representativeName String?
  representativeDocs String?

  // ── Mentions légales publiques (écrans CGU / Assistance mobile) ✅ v5.2
  // Distinctes de ownerFirstName/ownerLastName (propriétaire interne,
  // jamais affiché publiquement) — ce sont ici les infos affichées à
  // TOUS les utilisateurs. Réutilise contactEmail/contactPhone/address
  // déjà existants ci-dessus pour les coordonnées de contact.
  // ⚠️ Couvre l'IDENTITÉ/CONTACT uniquement — la substance des clauses
  // juridiques (juridiction, annulation, KYC, plafonds) reste du texte
  // fixe dans terms.tsx : la personnaliser par société demanderait une
  // vraie relecture juridique par société, pas un template.
  legalCompanyName         String?    // Nom légal complet, ex: "Direct Transf'air SAS"
                                       // (distinct de `name` = nom de marque, ex: "Flash Transfer")
  regulatorName            String?    // "Autorité de Contrôle Prudentiel et de Résolution (ACPR)"
  regulatorAcronym         String?    // "ACPR"
  regulatoryFrameworkLabel String?    // Badge écran CGU, ex: "DSP2" — absent = badge masqué
  regulatorLicenseNumber   String?    // "N° 12345"
  regulatorLicenseType     String?    // "Établissement de paiement"
  capitalSocial            String?    // "100 000 € entièrement libéré"
  supportEmail             String?    // Email affiché sur l'écran Assistance (distinct de contactEmail, utilisé sur CGU)
  whatsappNumber           String?    // Peut différer de contactPhone
  mediatorName             String?    // "Médiateur de l'ACPR"
  mediatorUrl              String?    // "https://www.acpr.banque-france.fr"
  termsVersion             String?    @default("1.0")
  termsEffectiveDate       DateTime?


  // ── Abonnement ────────────────────────────────────────
  subscriptionType   SubscriptionType   @default(RENTAL)
  subscriptionStatus SubscriptionStatus @default(ACTIVE)
  subscriptionStart  DateTime?
  subscriptionEnd    DateTime?
  trialEndsAt        DateTime?

  // ── Limites de transfert ──────────────────────────────
  maxDailyTransferAmount   Decimal? @db.Decimal(18, 4)
  maxMonthlyTransferAmount Decimal? @db.Decimal(18, 4)
  maxYearlyTransferAmount  Decimal? @db.Decimal(18, 4)
  maxTransactionAmount     Decimal? @db.Decimal(18, 4)

  // ── Compliance ────────────────────────────────────────
  requireKyc        Boolean        @default(false)
  kycLevel          Int            @default(1)
  allowedCurrencies CurrencyCode[] @default([XOF, EUR, USD, GNF, GBP])

  // ── Feature flags ─────────────────────────────────────
  featureScheduledTransfers Boolean @default(true)
  featureRateAlerts         Boolean @default(true)
  featureLoyaltyPoints      Boolean @default(false)
  featureCryptoPayouts      Boolean @default(false)
  featureCardPayments       Boolean @default(true)
  featureMobileWallets      Boolean @default(true)

  // ── Cycle de vie ──────────────────────────────────────
  isActive  Boolean   @default(true)
  deletedAt DateTime? // Soft delete

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ── Relations ─────────────────────────────────────────
  users              User[]
  agencies           Agency[]
  beneficiaries      Beneficiary[]
  transactions       Transaction[]
  withdrawals        Withdrawal[]
  commissionConfigs  CommissionConfig[]
  promotions         Promotion[]
  alerts             Alert[]
  auditLogs          AuditLog[]          @relation("ClientAuditLogs")
  apiKeys            ApiKey[]
  wallets            Wallet[]
  webhooks           WebhookEndpoint[]
  scheduledTransfers ScheduledTransfer[]
  loyaltyConfig      LoyaltyConfig?
  treasurySnapshots  TreasurySnapshot[]
  supportTickets     SupportTicket[]
  complianceCases    ComplianceCase[]

  @@index([tenantId])
  @@index([subscriptionStatus])
  @@index([country])
  @@index([subdomain])      // ✅ v5.1
  @@index([customDomain])   // ✅ v5.1
  @@map("clients")
}
//=============================================================
// WALLET (Multi-devises avec optimistic locking)
// =========================================================

model Wallet {
  id       String       @id @default(cuid())
  currency CurrencyCode

  balance         Decimal @default(0) @db.Decimal(18, 4)
  reservedBalance Decimal @default(0) @db.Decimal(18, 4) // Fonds en attente de débit

  isDefault Boolean @default(false)
  isActive  Boolean @default(true)
  isFrozen  Boolean @default(false)  // Freeze compliance/AML
  frozenReason String?
  frozenAt  DateTime?

  // Optimistic locking — incrémenter à chaque mise à jour de solde
  version Int @default(1)

  // Propriétaire polymorphe (user OU agency OU client)
  userId   String?
  user     User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  agencyId String?
  agency   Agency? @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  clientId Int?
  client   Client? @relation(fields: [clientId], references: [id], onDelete: Cascade)

  ledgerEntries LedgerEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, currency])
  @@unique([agencyId, currency])
  @@unique([clientId, currency])
  @@index([currency])
  @@map("wallets")
}

// =========================================================
// LEDGER (Livre de comptes fintech double-entrée)
// =========================================================

model LedgerEntry {
  id String @id @default(cuid())

  walletId String
  wallet   Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  transactionId String?
  transaction   Transaction? @relation(fields: [transactionId], references: [id])

  type         LedgerEntryType
  amount       Decimal         @db.Decimal(18, 4)
  currency     CurrencyCode
  description  String?
  balanceAfter Decimal         @db.Decimal(18, 4)

  externalRef         String? // Référence provider externe
  counterpartWalletId String? // Wallet de contrepartie (transferts internes)

  createdAt DateTime @default(now())

  @@index([walletId, createdAt])
  @@index([transactionId])
  @@map("ledger_entries")
}

// =========================================================
// AGENCY
// =========================================================

model Agency {
  id      String @id @default(cuid())
  name    String
  city    String
  address String

  type AgencyType @default(SUBSIDIARY)

  code  String? @unique
  email String?
  phone String?

  // Localisation → détermine devise principale
  country        String?      // ISO alpha-2 ex: "FR", "GN", "SN"
  postalCode     String?
  primaryCurrency CurrencyCode @default(XOF)

  creditLimit Decimal @default(0) @db.Decimal(18, 4)

  openingHours Json?
  latitude     Float?
  longitude    Float?
  isActive     Boolean @default(true)
  isCertified  Boolean @default(false) // Agence certifiée/vérifiée

  // Coordonnées bancaires
  ibanNumber String?
  bankName   String?
  bankBic    String?

  clientId Int
  client   Client @relation(fields: [clientId], references: [id])

  agents  User[]   @relation("AgencyAgents")
  wallets Wallet[] // Un wallet par devise supportée

  // ✅ v5.1 : Responsable désigné de l'agence.
  // AVANT : aucune façon fiable de savoir "qui gère cette agence" —
  // le frontend devinait via le premier agent d'une liste non triée
  // (agents: User[] sans ORDER BY garanti), et le backend n'avait
  // aucune notion de responsable du tout. Résultat concret : modifier
  // le téléphone/nom du "RESPONSABLE" dans l'app ne se répercutait
  // jamais sur le compte User réel de l'agent.
  // Un manager ne gère qu'une seule agence à la fois (cohérent avec
  // User.agencyId, qui limite déjà un user à une agence).
  managerId String? @unique
  manager   User?   @relation("AgencyManager", fields: [managerId], references: [id])

  deletedAt DateTime? // Soft delete

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@index([country])
  @@map("agencies")
}

// =========================================================
// USER
// =========================================================

model User {
  id       String  @id @default(cuid())
  email    String  @unique
  phone    String? @unique  // Requis pour connexion par téléphone
  password String
  role     Role    @default(USER)

  // Identité
  firstName String?
  lastName  String?
  gender    String?
  jobTitle  String?

  // Adresse résidence → détermine devise principale automatiquement
  addressStreet String?
  postalCode    String?
  city          String?
  country       String?       // ISO alpha-2 — clé pour devise auto

  // Devise principale déduite du pays de résidence
  primaryCurrency CurrencyCode @default(XOF)

  // Identité complémentaire
  nationality  String?
  birthDate    String?
  birthPlace   String?
  birthCountry String?
  birthCity    String?

  profilePictureUrl String?
  preferredLanguage String? @default("fr")

  // Coordonnées bancaires personnelles
  ibanNumber          String?
  bankName            String?
  bankBic             String?
  mobileMoneyOperator String?
  mobileMoneyNumber   String?

  // Compteurs de montants envoyés (remis à zéro périodiquement)
  dailySentAmount   Decimal @default(0) @db.Decimal(18, 4)
  monthlySentAmount Decimal @default(0) @db.Decimal(18, 4)
  yearlySentAmount  Decimal @default(0) @db.Decimal(18, 4)

  // Fidélité
  loyaltyPoints Int     @default(0)
  loyaltyTier   String? @default("BRONZE") // BRONZE, SILVER, GOLD, PLATINUM

  // Compliance
  complianceStatus ComplianceStatus @default(CLEAR)
  kycLevel         KycLevel         @default(LEVEL_0)

  // Vérifications
  isEmailVerified Boolean   @default(false)
  isPhoneVerified Boolean   @default(false)
  isActive        Boolean   @default(true)
  isSuspended     Boolean   @default(false)
  suspendedReason String?
  suspendedAt     DateTime?

  // OTP — utilisé à chaque connexion (email ou téléphone)
  otpCode      String?
  otpExpiresAt DateTime?
  otpPurpose   OtpPurpose?
  otpChannel   CommsType?  // EMAIL ou SMS

  // Sécurité / verrouillage
  failedLoginAttempts Int       @default(0)
  lastFailedLoginAt   DateTime?
  lockedUntil         DateTime?
  lastLoginAt         DateTime?
  lastLoginIp         String?
  lastLoginCountry    String?

  // MFA
  mfaEnabled     Boolean  @default(false)
  mfaSecret      String?
  mfaBackupCodes String[]

  // Parrainage
  referralCode String?  @unique
  referredById String?
  referredBy   User?    @relation("Referrals", fields: [referredById], references: [id])
  referrals    User[]   @relation("Referrals")

  // Soft delete
  deletedAt DateTime?

  // Appartenance
  clientId Int?
  client   Client? @relation(fields: [clientId], references: [id])

  agencyId String?
  agency   Agency? @relation("AgencyAgents", fields: [agencyId], references: [id])

  // ✅ v5.1 : pointeur inverse — si ce user est LE responsable désigné
  // d'une agence (voir Agency.managerId ci-dessus)
  managedAgency Agency? @relation("AgencyManager")

  // Relations financières
  wallets              Wallet[]
  cards                UserCard[]
  mobileWallets        UserMobileWallet[]
  sentTransactions     Transaction[]      @relation("Sender")
  receivedTransactions Transaction[]      @relation("Recipient")
  beneficiaries        Beneficiary[]
  processedWithdrawals Withdrawal[]       @relation("ProcessedWithdrawals")
  scheduledTransfers   ScheduledTransfer[]
  rateAlerts           RateAlert[]
  loyaltyTransactions  LoyaltyTransaction[]
  promotionsUsed       PromotionUse[]

  // Relations sécurité / logs
  sessions      UserSession[]
  devices       UserDevice[]
  otpLogs       OtpLog[]
  loginHistory  LoginHistory[]
  auditLogs     AuditLog[]
  kyc           KycDocument[]
  amlFlags      AmlFlag[]

  // Notifications / comms
  notifications     Notification[]
  communicationLogs CommunicationLog[]
  alerts            Alert[]            @relation("AlertUser")

  // Support
  supportTickets SupportTicket[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@index([agencyId])
  @@index([role])
  @@index([country])
  @@index([phone])
  @@index([complianceStatus])
  @@map("users")
}

// =========================================================
// USER DEVICE (Push tokens FCM/APNS + appareil de confiance)
// =========================================================

model UserDevice {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  platform DevicePlatform
  status   DeviceStatus   @default(PENDING)

  // Push notification
  pushToken   String?  // FCM (Android) ou APNS (iOS)
  pushEnabled Boolean  @default(true)

  // Fingerprint appareil
  deviceId        String   // Identifiant unique appareil
  deviceName      String?  // Ex: "iPhone 15 Pro de Doniko"
  deviceModel     String?
  osVersion       String?
  appVersion      String?
  fingerprintHash String?  // Hash fingerprint pour détection fraude

  ipAddress  String?
  lastUsedAt DateTime  @default(now())
  trustedAt  DateTime?
  revokedAt  DateTime?

  createdAt DateTime @default(now())

  @@unique([userId, deviceId])
  @@index([userId, status])
  @@map("user_devices")
}

// =========================================================
// LOGIN HISTORY (Historique de connexions)
// =========================================================

model LoginHistory {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  ipAddress     String?
  country       String?
  city          String?
  device        String?
  userAgent     String?
  success       Boolean  @default(true)
  failureReason String?

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@map("login_history")
}

// =========================================================
// OTP LOG (Traçabilité complète des OTP)
// =========================================================

model OtpLog {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  code      String
  purpose   OtpPurpose
  channel   CommsType  // EMAIL ou SMS
  recipient String     // Email ou numéro

  isUsed    Boolean   @default(false)
  usedAt    DateTime?
  expiresAt DateTime
  attempts  Int       @default(0)
  isExpired Boolean   @default(false)

  ipAddress String?

  createdAt DateTime @default(now())

  @@index([userId, purpose])
  @@map("otp_logs")
}

// =========================================================
// USER SESSION
// =========================================================

model UserSession {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  token     String        @unique
  status    SessionStatus @default(ACTIVE)
  device    String?
  deviceId  String?       // Lien vers UserDevice
  ipAddress String?
  userAgent String?
  country   String?       // Pays de connexion détecté
  expiresAt DateTime
  revokedAt DateTime?

  // Refresh token
  refreshToken          String?  @unique
  refreshTokenExpiresAt DateTime?

  createdAt DateTime @default(now())

  @@index([userId, status])
  @@map("user_sessions")
}

// =========================================================
// USER CARD (Carte bancaire tokenisée PSP)
// =========================================================

model UserCard {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  last4          String
  expiry         String    // Format "MM/YY"
  brand          CardBrand @default(VISA)
  cardholderName String?   // Nom sur la carte

  isDefault  Boolean @default(false)
  isActive   Boolean @default(true)
  isVerified Boolean @default(false) // Vérifiée via 3DS ou micro-débit

  // Tokenisation PSP (ne jamais stocker le PAN complet)
  providerToken String? // Token Stripe / Flutterwave / autre PSP
  providerName  String? // "stripe", "flutterwave"
  fingerprint   String? // Fingerprint PSP pour déduplication

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("user_cards")
}

// =========================================================
// USER MOBILE WALLET (Orange Money, Wave, etc.)
// =========================================================

model UserMobileWallet {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  provider   PaymentMethod
  number     String
  currency   CurrencyCode?
  alias      String?   // Nom personnalisé ex: "Mon Orange Money"

  isDefault  Boolean @default(false)
  isVerified Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, provider, number])
  @@index([userId])
  @@map("user_mobile_wallets")
}

// =========================================================
// KYC & COMPLIANCE
// =========================================================

model KycDocument {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type        KycDocumentType
  status      KycStatus       @default(PENDING)
  documentUrl String
  backUrl     String?

  documentNumber String?
  expiryDate     DateTime?
  issuedCountry  String?

  // Versionning pour re-soumission
  version Int @default(1)

  rejectionReason String?
  reviewedAt      DateTime?
  reviewedById    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
  @@map("kyc_documents")
}

model AmlFlag {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  transactionId String?
  transaction   Transaction? @relation(fields: [transactionId], references: [id])

  reason     String
  riskScore  Int      @default(50) // Score 1 à 100
  isReviewed Boolean  @default(false)
  reviewedBy String?
  reviewedAt DateTime?
  resolution String?

  createdAt DateTime @default(now())

  @@index([userId, isReviewed])
  @@map("aml_flags")
}

// =========================================================
// COMPLIANCE CASE (Dossiers AML/KYC structurés)
// =========================================================

model ComplianceCase {
  id String @id @default(cuid())

  userId        String?
  transactionId String?

  clientId Int?
  client   Client? @relation(fields: [clientId], references: [id])

  reason String
  notes  String?

  status     ComplianceCaseStatus @default(OPEN)
  assignedTo String?              // userId de l'analyste
  resolvedAt DateTime?
  resolution String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([clientId])
  @@map("compliance_cases")
}

// =========================================================
// BENEFICIARY
// =========================================================

model Beneficiary {
  id       String  @id @default(cuid())
  fullName String
  country  String
  city     String
  phone    String?
  email    String?

  // Devise attendue selon pays du bénéficiaire
  expectedCurrency CurrencyCode?

  // Coordonnées bancaires
  bankName    String?
  bankAccount String?
  bankIban    String?
  bankBic     String?

  // Mobile Money
  mobileMoneyOperator String?
  mobileMoneyNumber   String?

  isFavorite    Boolean @default(false)
  transferCount Int     @default(0)

  userId String
  user   User   @relation(fields: [userId], references: [id])

  clientId Int
  client   Client @relation(fields: [clientId], references: [id])

  transactions       Transaction[]
  scheduledTransfers ScheduledTransfer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([clientId])
  @@index([country])
  @@map("beneficiaries")
}

// =========================================================
// TRANSACTION
// =========================================================

model Transaction {
  id        String @id @default(cuid())
  reference String @unique

  type      TransactionType      @default(TRANSFER)
  direction TransactionDirection @default(OUTBOUND)

  amount Decimal @db.Decimal(18, 4)
  fees   Decimal @db.Decimal(18, 4)
  total  Decimal @db.Decimal(18, 4)

  // Multi-devise
  currency       CurrencyCode
  targetCurrency CurrencyCode?
  exchangeRate   Float?                       // Taux au moment de la transaction
  receivedAmount Decimal?     @db.Decimal(18, 4) // Montant reçu après conversion

  // Commissions
  senderCommission   Decimal? @db.Decimal(18, 4)
  payerCommission    Decimal? @db.Decimal(18, 4)
  platformCommission Decimal? @db.Decimal(18, 4)

  status        TransactionStatus @default(PENDING)
  payoutMethod  PayoutMethod      @default(CASH_PICKUP)
  paymentMethod PaymentMethod     @default(WALLET)

  // Provider paiement
  provider         PaymentProvider?
  providerRef      String?          @unique
  providerStatus   ProviderStatus?  @default(PENDING)
  providerMetadata Json?            // Réponse brute du provider

  // Compliance
  riskScore Int     @default(0)   // Score de risque calculé 0-100
  isFlagged Boolean @default(false)

  note         String?
  pickupCode   String?
  pickupExpiry DateTime?

  // Documents
  receiptUrl String? // Reçu PDF généré
  invoiceUrl String? // Facture si applicable

  // Virement programmé origine
  scheduledTransferId String?
  scheduledTransfer   ScheduledTransfer? @relation(fields: [scheduledTransferId], references: [id])

  senderId String
  sender   User   @relation("Sender", fields: [senderId], references: [id])

  recipientId String?
  recipient   User?   @relation("Recipient", fields: [recipientId], references: [id])

  beneficiaryId String?
  beneficiary   Beneficiary? @relation(fields: [beneficiaryId], references: [id])

  clientId Int
  client   Client @relation(fields: [clientId], references: [id])

  // Promotion appliquée
  promotionId String?
  promotion   Promotion? @relation(fields: [promotionId], references: [id])

  // Fidélité
  loyaltyPointsEarned Int @default(0)

  // Horodatages métier
  validatedAt DateTime?
  paidAt      DateTime?
  cancelledAt DateTime?
  failedAt    DateTime?
  expiresAt   DateTime?

  // ✅ v5.1 — Soft delete (cohérent avec User/Client/Agency)
  //
  //   Ajouté initialement pour qu'AgenciesService.remove() puisse
  //   suppression-douce les transactions d'une agence supprimée au
  //   lieu de les effacer définitivement. Le design a depuis été
  //   révisé (agencies.service.ts v4.5) : supprimer une agence
  //   désactive désormais l'agence et ses agents (soft-delete sur
  //   User/Agency, déjà présents dans le schéma) SANS jamais toucher
  //   Transaction — donc ce champ n'est plus utilisé par ce flux
  //   précis. Conservé comme infrastructure générale disponible pour
  //   un futur besoin de suppression douce ciblée (ex. annulation
  //   d'une transaction frauduleuse à masquer de l'historique client
  //   sans perdre la trace comptable) ; les lectures de
  //   TransactionsService le filtrent déjà par précaution (voir
  //   transactions.service.ts v4.20).
  //   ⚠️ Migration requise : npx prisma migrate dev --name add_transaction_soft_delete
  deletedAt DateTime?

  // Relations
  withdrawal          Withdrawal?
  ledgerEntries       LedgerEntry[]
  amlFlags            AmlFlag[]
  commsLogs           CommunicationLog[]
  loyaltyTransactions LoyaltyTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId, status])
  @@index([senderId])
  @@index([createdAt])
  @@index([reference])
  @@index([currency, targetCurrency])
  @@index([isFlagged])
  @@map("transactions")
}

// =========================================================
// WITHDRAWAL
// =========================================================

model Withdrawal {
  id String @id @default(cuid())

  transactionId String      @unique
  transaction   Transaction @relation(fields: [transactionId], references: [id])

  method PayoutMethod
  status WithdrawalStatus @default(PENDING)

  // Détails paiement bénéficiaire
  recipientIban      String?
  recipientBankName  String?
  recipientMobileOp  String?
  recipientMobileNum String?

  requestedAt   DateTime  @default(now())
  processedAt   DateTime?
  processedById String?
  processedBy   User?     @relation("ProcessedWithdrawals", fields: [processedById], references: [id])
  expiresAt     DateTime?

  rejectionReason String?

  clientId Int
  client   Client @relation(fields: [clientId], references: [id])

  @@index([clientId, status])
  @@map("withdrawals")
}

// =========================================================
// SCHEDULED TRANSFERS (Virements programmés)
// =========================================================

model ScheduledTransfer {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  clientId Int
  client   Client @relation(fields: [clientId], references: [id])

  beneficiaryId String?
  beneficiary   Beneficiary? @relation(fields: [beneficiaryId], references: [id])

  amount         Decimal      @db.Decimal(18, 4)
  currency       CurrencyCode
  targetCurrency CurrencyCode?
  payoutMethod   PayoutMethod @default(CASH_PICKUP)
  note           String?

  frequency  ScheduledFrequency @default(ONCE)
  status     ScheduledStatus    @default(ACTIVE)

  nextExecutionAt DateTime
  lastExecutedAt  DateTime?
  executionCount  Int @default(0)
  maxExecutions   Int? // null = illimité

  failureReason String?
  failureCount  Int @default(0)

  transactions Transaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
  @@index([nextExecutionAt, status])
  @@map("scheduled_transfers")
}

// =========================================================
// RATE ALERTS (Alertes taux de change)
// =========================================================

model RateAlert {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  pair      String             // Ex: "EUR_GNF"
  direction RateAlertDirection
  threshold Float              // Taux seuil

  isTriggered Boolean   @default(false)
  triggeredAt DateTime?
  isActive    Boolean   @default(true)

  notifiedVia CommsType[] @default([PUSH, EMAIL])

  createdAt DateTime @default(now())

  @@index([userId, isActive])
  @@index([pair, isActive])
  @@map("rate_alerts")
}

// =========================================================
// LOYALTY (Programme de fidélité)
// =========================================================

model LoyaltyConfig {
  id       String @id @default(cuid())
  clientId Int    @unique
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  pointsPerEuro     Float @default(1.0)   // Points gagnés par euro transféré
  euroPerPoint      Float @default(0.01)  // Valeur d'un point en euro
  bronzeThreshold   Int   @default(0)
  silverThreshold   Int   @default(1000)
  goldThreshold     Int   @default(5000)
  platinumThreshold Int   @default(20000)
  isActive          Boolean @default(true)

  @@map("loyalty_configs")
}

model LoyaltyTransaction {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  transactionId String?
  transaction   Transaction? @relation(fields: [transactionId], references: [id])

  points       Int    // Positif = crédit, négatif = débit
  description  String
  balanceAfter Int

  createdAt DateTime @default(now())

  @@index([userId])
  @@map("loyalty_transactions")
}

// =========================================================
// COMMUNICATIONS (Email, SMS, Push, In-App)
// =========================================================

model CommunicationLog {
  id String @id @default(cuid())

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  transactionId String?
  transaction   Transaction? @relation(fields: [transactionId], references: [id])

  type      CommsType
  recipient String    // Email, numéro de téléphone, ou push token

  // Email
  subject  String?
  htmlBody String?
  textBody String?

  // SMS
  smsContent String?

  // Push
  pushTitle String?
  pushBody  String?
  pushData  Json?   // Payload custom FCM/APNS

  // Template
  templateId   String?
  templateVars Json?

  status     CommsStatus @default(PENDING)
  errorMsg   String?
  retryCount Int         @default(0)

  providerId   String? // ID retourné par Sendgrid, Twilio, FCM, etc.
  providerName String? // "sendgrid", "twilio", "fcm", "apns"

  // Debug & déduplication
  metadata   Json?   // Données arbitraires pour debugging
  externalId String? // ID externe pour déduplication côté provider

  createdAt   DateTime  @default(now())
  sentAt      DateTime?
  deliveredAt DateTime?
  readAt      DateTime?

  @@index([userId, status])
  @@index([transactionId])
  @@index([type, status])
  @@map("communication_logs")
}

model CommsTemplate {
  id       String @id @default(cuid())
  clientId Int?   // null = template global plateforme

  slug     String    @unique  // Ex: "transfer_receipt", "otp_login", "kyc_approved"
  name     String
  type     CommsType

  subject   String?   // Pour emails
  htmlBody  String?   // Corps HTML email
  textBody  String?   // Corps texte email/SMS
  pushTitle String?   // Titre push
  pushBody  String?   // Corps push

  variables String[]  // Ex: ["{{firstName}}", "{{amount}}", "{{currency}}"]
  isActive  Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("comms_templates")
}

// =========================================================
// NOTIFICATIONS IN-APP
// =========================================================

model Notification {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title    String
  message  String
  type     NotificationType      @default(INFO)
  channels NotificationChannel[] @default([IN_APP])
  priority NotificationPriority  @default(NORMAL)

  isRead Boolean   @default(false)
  readAt DateTime?

  // Action associée (deep link ou URL web)
  actionUrl   String?
  actionLabel String?

  metadata Json?

  // Image/icône personnalisée
  imageUrl String?

  // Regroupement (ex: "transactions", "kyc")
  groupKey String?

  // Expiration automatique
  expiresAt DateTime?

  createdAt DateTime @default(now())

  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@index([groupKey])
  @@map("notifications")
}

// =========================================================
// WEBHOOKS (SaaS API)
// =========================================================

model WebhookEndpoint {
  id String @id @default(cuid())

  clientId Int
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  url      String
  secret   String
  isActive Boolean  @default(true)
  events   String[] // Ex: ["transaction.created", "transaction.paid", "kyc.approved"]

  // Retry config
  maxRetries   Int @default(3)
  retryDelayMs Int @default(5000)

  deliveries WebhookDelivery[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("webhook_endpoints")
}

model WebhookDelivery {
  id String @id @default(cuid())

  endpointId String
  endpoint   WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  event       String
  payload     Json
  statusCode  Int?
  response    String?
  status      WebhookStatus @default(PENDING)
  attempts    Int           @default(0)
  nextRetryAt DateTime?
  lastAttemptAt DateTime?

  createdAt DateTime @default(now())

  @@index([endpointId, status])
  @@map("webhook_deliveries")
}

// =========================================================
// EXCHANGE RATE
// =========================================================

model ExchangeRate {
  id String @id @default(cuid())

  // Paire de devises (toujours BASE_QUOTE)
  // Ex: "EUR_GNF", "EUR_XOF", "USD_GNF", "GBP_GNF", "GBP_EUR"
  pair String @unique

  rate        Float
  inverseRate Float?       // Calculé automatiquement (1/rate)
  spread      Float? @default(0) // Spread appliqué sur le taux marché (en %)

  source    String?  @default("manual") // "manual", "api", "ecb", "xe.com"
  validFrom DateTime @default(now())
  validTo   DateTime?

  isActive Boolean @default(true) // Désactiver sans supprimer

  // Suivi variation
  previousRate  Float?
  changePercent Float?

  // Métadonnées provider
  providerMetadata Json?

  // Versionning
  version Int @default(1)

  updatedAt DateTime @updatedAt
  updatedBy String?  // userId de l'admin

  history ExchangeRateHistory[]

  @@index([pair])
  @@index([pair, isActive])
  @@map("exchange_rates")
}

model ExchangeRateHistory {
  id String @id @default(cuid())

  rateId       String
  exchangeRate ExchangeRate @relation(fields: [rateId], references: [id], onDelete: Cascade)

  pair       String
  rate       Float
  source     String?
  recordedAt DateTime @default(now())

  @@index([pair, recordedAt])
  @@map("exchange_rate_history")
}

// =========================================================
// COMMISSION CONFIG & TIERS
// =========================================================

model CommissionConfig {
  id String @id @default(cuid())

  clientId Int
  client   Client @relation(fields: [clientId], references: [id])

  sourceType CommissionSourceType
  destType   CommissionDestType

  // Devise de référence (null = s'applique à toutes)
  currency CurrencyCode?

  // ✅ Champs fee config — ajoutés pour fees.tsx (v1.1)
  payoutMethod String?           // "CASH_PICKUP" | "BANK_DEPOSIT" | "MOBILE_MONEY" | "IBAN_TRANSFER"
  feeRate      Float @default(0) // Taux réel prélevé sur l'expéditeur (ex: 1.5 = 1.5%)
  fixedFee     Float @default(0) // Frais fixe en devise locale (ex: 200 = 200 XOF)

  senderShare   Float @default(0)
  payerShare    Float @default(0)
  platformShare Float @default(100)

  description String? // Note interne pour l'admin
  priority    Int     @default(0) // Ordre d'application si plusieurs configs

  tiers CommissionTier[]

  isActive  Boolean  @default(true)
  updatedAt DateTime @updatedAt

  @@unique([clientId, sourceType, destType, currency])
  @@map("commission_configs")
}

model CommissionTier {
  id String @id @default(cuid())

  configId String
  config   CommissionConfig @relation(fields: [configId], references: [id], onDelete: Cascade)

  minAmount     Decimal  @db.Decimal(18, 4)
  maxAmount     Decimal? @db.Decimal(18, 4)
  senderShare   Float
  payerShare    Float
  platformShare Float
  fixedFee      Decimal? @db.Decimal(18, 4) // Frais fixe additionnel

  @@map("commission_tiers")
}

// =========================================================
// AUDIT LOGS
// =========================================================

model AuditLog {
  id String @id @default(cuid())

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  clientId Int?
  client   Client? @relation("ClientAuditLogs", fields: [clientId], references: [id])

  action     AuditAction
  entity     String?
  entityId   String?
  details    Json?
  ipAddress  String?
  userAgent  String?
  country    String?     // Pays de l'action (géolocalisation IP)
  successful Boolean     @default(true)
  errorMsg   String?

  createdAt DateTime @default(now())

  @@index([userId, action])
  @@index([clientId, createdAt])
  @@index([entity, entityId])
  @@map("audit_logs")
}

// =========================================================
// ALERTS
// =========================================================

model Alert {
  id String @id @default(cuid())

  clientId Int?
  client   Client? @relation(fields: [clientId], references: [id])

  userId String?
  user   User?   @relation("AlertUser", fields: [userId], references: [id])

  type     AlertType
  severity AlertSeverity @default(MEDIUM)
  title    String
  message  String
  metadata Json?

  isResolved Boolean   @default(false)
  resolvedAt DateTime?
  resolvedBy String?

  createdAt DateTime @default(now())

  @@index([clientId, isResolved])
  @@index([severity, isResolved])
  @@map("alerts")
}

// =========================================================
// PROMOTIONS
// =========================================================

model Promotion {
  id   String @id @default(cuid())
  code String @unique

  clientId Int?
  client   Client? @relation(fields: [clientId], references: [id])

  type        PromotionType
  title       String
  description String?

  discountValue Float   @default(0)
  isPercentage  Boolean @default(true)

  minAmount   Decimal? @db.Decimal(18, 4)
  maxDiscount Decimal? @db.Decimal(18, 4)

  // Devises éligibles (vide = toutes)
  eligibleCurrencies CurrencyCode[] @default([])

  usageLimit   Int?
  usageCount   Int @default(0)
  perUserLimit Int @default(1)

  validFrom DateTime
  validTo   DateTime

  isActive Boolean @default(true)

  transactions Transaction[]
  uses         PromotionUse[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([code, isActive])
  @@map("promotions")
}

model PromotionUse {
  id String @id @default(cuid())

  promotionId String
  promotion   Promotion @relation(fields: [promotionId], references: [id])

  userId String
  user   User   @relation(fields: [userId], references: [id])

  transactionId String?
  usedAt        DateTime @default(now())

  @@unique([promotionId, userId])
  @@map("promotion_uses")
}

// =========================================================
// API KEYS
// =========================================================

model ApiKey {
  id String @id @default(cuid())

  clientId Int
  client   Client @relation(fields: [clientId], references: [id])

  name      String
  keyHash   String   @unique
  keyPrefix String

  scopes      String[]
  isActive    Boolean  @default(true)
  ipWhitelist String[] @default([]) // IPs autorisées

  lastUsedAt DateTime?
  expiresAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@map("api_keys")
}

// =========================================================
// TREASURY SNAPSHOT
// Snapshot quotidien de trésorerie par devise
// Alimente les dashboards Super Admin & Company Admin
// =========================================================

model TreasurySnapshot {
  id String @id @default(cuid())

  clientId Int?     // null = snapshot global (Super Admin)
  client   Client?  @relation(fields: [clientId], references: [id])

  currency CurrencyCode
  date     DateTime     @db.Date

  // Volumes du jour
  totalSent       Decimal @db.Decimal(18, 4)
  totalReceived   Decimal @db.Decimal(18, 4)
  totalFees       Decimal @db.Decimal(18, 4)
  totalCommission Decimal @db.Decimal(18, 4)

  // Soldes
  openingBalance Decimal @db.Decimal(18, 4)
  closingBalance Decimal @db.Decimal(18, 4)

  // Métriques
  transactionCount     Int     @default(0)
  uniqueSenders        Int     @default(0)
  avgTransactionAmount Decimal? @db.Decimal(18, 4)
  refundedAmount       Decimal? @db.Decimal(18, 4)
  failedCount          Int      @default(0)

  // Annotation manuelle admin
  notes String?

  createdAt DateTime @default(now())

  @@unique([clientId, currency, date])
  @@index([currency, date])
  @@map("treasury_snapshots")
}

// =========================================================
// SUPPORT TICKETS
// =========================================================

model SupportTicket {
  id String @id @default(cuid())

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  clientId Int?
  client   Client? @relation(fields: [clientId], references: [id])

  subject  String
  message  String
  category String? // Ex: "transaction", "kyc", "account", "technical"

  status   SupportTicketStatus   @default(OPEN)
  priority SupportTicketPriority @default(MEDIUM)

  assignedTo String?     // userId de l'agent support
  resolvedAt DateTime?
  closedAt   DateTime?

  // Métadonnées (transactionId concernée, etc.)
  metadata Json?

  replies SupportTicketReply[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([clientId])
  @@index([userId])
  @@map("support_tickets")
}

model SupportTicketReply {
  id       String @id @default(cuid())
  ticketId String
  ticket   SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  authorId   String  // userId de l'auteur (client ou agent)
  isInternal Boolean @default(false) // Note interne non visible par le client
  message    String

  createdAt DateTime @default(now())

  @@index([ticketId])
  @@map("support_ticket_replies")
}

