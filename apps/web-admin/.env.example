# URL du backend NestJS (avec ou sans /api, les deux fonctionnent).
# OBLIGATOIRE en production. En dev, http://localhost:3000 est utilisé par défaut.
VITE_API_URL=http://localhost:3000

# (optionnel) Domaines qui affichent le portail PLATEFORME (super admin), séparés par des virgules.
# Si renseigné, tout autre domaine non reconnu comme société affiche « Portail introuvable ».
# Si vide, un domaine non reconnu retombe sur le portail plateforme.
# Exemple : VITE_PLATFORM_HOSTS=admin.directtransfair.app
VITE_PLATFORM_HOSTS=

# (optionnel) Force un code société, quel que soit le domaine (utile pour tester un portail précis).
# Laisser vide en production : la société est déduite du domaine.
VITE_TENANT_CODE=

# (optionnel) Autorise ?tenant=CODE dans l'URL en production (déjà actif en dev).
# Laisser à false en production.
VITE_ALLOW_TENANT_QUERY=false
